#!/bin/sh
# B8130: refuse a push to a pull request in the merge train (tools/git-hooks/pre-push.mjs).
# Node's fetch reads HTTPS_PROXY only with NODE_USE_ENV_PROXY=1 (the cloud's agent proxy, B7241).
[ -n "${HTTPS_PROXY:-$https_proxy}" ] && export NODE_USE_ENV_PROXY=1
exec node --no-warnings "$(git rev-parse --show-toplevel)/tools/git-hooks/pre-push.mjs" "$@"
