 "labels": [
  {
   "x": 21.5,
   "y": 5.0,
   "text": "There is no bed. Bogdan lies by day in a long iron-bound chest of Carpathian ear"
  },
  {
   "x": 21.275,
   "y": 8.225,
   "text": "Voivode Bogdan Ursu lives here (The Voivode's Floor, The Voivode's Bedchamber)."
  },
  {
   "x": 40.0,
   "y": 6.0,
   "text": "The flesh-rites are written in a careful hand on the wall above the tables."
  },
  {
   "x": 25.8,
   "y": 28.1,
   "text": "The great stair down to the guard hall."
  },
  {
   "x": 46.0,
   "y": 19.5,
   "text": "A captured villager, alive, does not remember..."
  },
  {
   "x": 53.0,
   "y": 6.0,
   "text": "Konrad's day-rest: a long chest of native earth..."
  },
  {
   "x": 21.5,
   "y": 8.0,
   "text": "Every guest is watched. A squint in the wall looks down into the great hall."
  },
  {
   "x": 40.225,
   "y": 9.225,
   "text": "Konrad the Flesh-Smith lives here (The Undercroft, Konrad's Workshop)."
  },
  {
   "x": 55.8,
   "y": 28.1,
   "text": "The narrow stair up to the guard hall."
  }
 ],
