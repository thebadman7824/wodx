<form class="{{cssClass}} flexcol {{#if locked}}locked{{/if}} {{getEra actor}} wodx-sheet wodx-fae-da" autocomplete="off">
	<div class="sheet-character">
		<header class="sheet-header"></header>
		<section class="sheet-body">
			<div class="navigation pullLeft">
				{{#if (not actor.limited)}}{{> "systems/worldofdarkness/templates/actor/parts/profile-img.html"}}{{/if}}
				{{> "systems/worldofdarkness/templates/actor/parts/navigation.html"}}
			</div>
			<div class="pullRight">{{> "systems/worldofdarkness/templates/actor/parts/macro_icons.html"}}</div>
			<div class="centerText sheet-headline splatFont">Dark Ages: Fae</div>

			<div class="tab bio sheet-inner-area" data-group="primary" data-tab="bio">
				{{~> "systems/worldofdarkness/templates/actor/parts/bio.html"}}
			</div>

			{{!-- Page one of the book's sheet --}}
			<div class="tab core sheet-inner-area" data-group="primary" data-tab="core">
				<div class="wodx-head">
					<div class="wodx-field"><label>Court</label><select class="wodx-pick" data-wodx="court">{{#each wodx.courts}}<option value="{{this.id}}" {{#if this.sel}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></div>
					<div class="wodx-field"><label>Origin</label><select class="wodx-pick" data-wodx="origin">{{#each wodx.origins}}<option value="{{this.id}}" {{#if this.sel}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></div>
					<div class="wodx-field"><label>Agenda</label><input type="text" class="wodx-text" data-wodx="agenda" value="{{wodx.agenda}}"/></div>
				</div>

				<div class="sheet-area flex-columns">
					{{> "systems/worldofdarkness/templates/actor/parts/attributes.html"}}
				</div>

				<div class="sheet-area flex-columns">
					<div class="clearareaBox area-box">
						<div class="sheet-headline sheet-banner splatFont"><span class="sheet-banner-text">Abilities</span></div>
						<div class="wodx-cols">
							{{#each wodx.abilityCols}}
							<div class="wodx-col">
								<div class="headlineGroup splatFont centerText">{{this.title}}</div>
								{{#each this.rows}}
								<div class="clearareaBox wodx-row">
									{{#if this.missing}}
										<label class="pullLeft ability-headlineWidth headlineNormal wodx-missing" title="Not on the sheet yet: give it a dot to add it">{{this.label}}</label>
										<div class="pullLeft wodx-dots" data-add-ability="{{this.label}}" data-group="{{this.group}}" data-flatkey="{{#unless this.secondary}}{{this.key}}{{/unless}}">{{#each this.dots}}<span class="wodx-dot" data-i="{{this.i}}"></span>{{/each}}</div>
									{{else}}
										<label class="pullLeft vrollable ability-headlineWidth headlineNormal" data-type="{{@root.config.sheettype.mortal}}" data-key="{{this.id}}" data-ability="true">{{this.label}}</label>
										<div class="pullLeft resource-value" data-value="{{this.value}}" data-name="abilities.{{this.id}}.value" data-key="{{this.id}}" data-ability="{{#if this.secondary}}secondary{{else}}core{{/if}}">
											{{#each this.dots}}<span class="resource-value-step" data-type="{{@root.config.sheettype.mortal}}" data-index="{{this.i}}" {{#if ../secondary}}data-ability="secondary" data-itemid="{{../id}}"{{else}}data-ability="core"{{/if}}></span>{{/each}}
										</div>
									{{/if}}
								</div>
								{{/each}}
							</div>
							{{/each}}
						</div>
					</div>
				</div>

				<div class="sheet-area flex-columns">
					<div class="clearareaBox area-box">
						<div class="sheet-headline sheet-banner splatFont"><span class="sheet-banner-text">Advantages</span></div>
						<div class="wodx-cols">
							<div class="wodx-col">
								<div class="headlineGroup splatFont centerText">Dominions</div>
								{{#each wodx.dominions}}
								<div class="clearareaBox wodx-row">
									<label class="pullLeft ability-headlineWidth headlineNormal wodx-roll {{#if this.favored}}wodx-favored{{/if}}" data-roll="daCantrip" title="{{this.gloss}}{{#if this.favored}} (the Court's Dominion){{/if}}">{{this.label}}</label>
									<div class="pullLeft wodx-dots" data-flag="dominions.{{this.id}}">{{#each this.dots}}<span class="wodx-dot {{#if this.on}}on{{/if}}" data-i="{{this.i}}"></span>{{/each}}</div>
								</div>
								{{/each}}
							</div>
							<div class="wodx-col">
								<div class="headlineGroup splatFont centerText">Backgrounds</div>
								{{#each wodx.backgrounds}}
								<div class="clearareaBox wodx-row">
									<label class="pullLeft ability-headlineWidth headlineNormal wodx-open" data-itemid="{{this.id}}">{{this.name}}</label>
									<div class="pullLeft wodx-dots ro">{{#each this.dots}}<span class="wodx-dot {{#if this.on}}on{{/if}}"></span>{{/each}}</div>
								</div>
								{{else}}<div class="wodx-quiet">None yet: add them as Features (Background).</div>{{/each}}
							</div>
							<div class="wodx-col">
								<div class="headlineGroup splatFont centerText">Cantrips</div>
								{{#each wodx.cantrips}}
								<div class="clearareaBox wodx-row wodx-cantrip"><a class="wodx-roll" data-roll="daCantrip" title="{{this.trait}}">{{this.name}}</a> <span class="wodx-quiet">{{this.dominion}} {{this.level}}</span></div>
								{{else}}<div class="wodx-quiet">None yet.</div>{{/each}}
								<div class="wodx-quiet">{{wodx.cantripNote}}</div>
							</div>
						</div>
					</div>
				</div>

				<div class="sheet-area flex-columns">
					<div class="clearareaBox wodx-cols wodx-bottom">
						<div class="wodx-col">
							{{{getGetStatArea actor actor.system.advantages.willpower "willpower" true true true}}}
							<div class="sheet-headline sheet-banner-small splatFont"><span class="sheet-banner-text">Other Traits</span></div>
							{{#each wodx.otherTraits}}
							<div class="clearareaBox wodx-row"><label class="pullLeft ability-headlineWidth headlineNormal wodx-open" data-itemid="{{this.id}}">{{this.name}}</label><div class="pullLeft wodx-dots ro">{{#each this.dots}}<span class="wodx-dot {{#if this.on}}on{{/if}}"></span>{{/each}}</div></div>
							{{else}}<div class="wodx-quiet">—</div>{{/each}}
						</div>
						<div class="wodx-col wodx-mw">
							<div class="sheet-headline sheet-banner-small splatFont"><span class="sheet-banner-text">Mists &amp; Weaving</span></div>
							<div class="wodx-track-title wodx-roll" data-roll="daMists" title="The Mists: hide, cloak, Kenning">Mists</div>
							<div class="wodx-track" data-flag="mists">
								<div class="wodx-dots ten">{{#each wodx.mists}}<span class="wodx-dot {{#if this.dot}}on{{/if}}" data-i="{{this.i}}"></span>{{/each}}</div>
								<div class="wodx-boxes ten">{{#each wodx.mists}}<span class="wodx-box {{#if this.box}}on{{/if}}" data-i="{{this.i}}"></span>{{/each}}</div>
							</div>
							<div class="wodx-track-title wodx-roll" data-roll="daUnleash" title="Unleash a Dominion">Weaving</div>
							<div class="wodx-track" data-flag="weaving">
								<div class="wodx-dots ten">{{#each wodx.weaving}}<span class="wodx-dot {{#if this.dot}}on{{/if}}" data-i="{{this.i}}"></span>{{/each}}</div>
								<div class="wodx-boxes ten">{{#each wodx.weaving}}<span class="wodx-box {{#if this.box}}on{{/if}}" data-i="{{this.i}}"></span>{{/each}}</div>
							</div>
							{{#if wodx.imbalance}}<div class="wodx-warn">{{wodx.imbalance}}</div>{{/if}}
							<div class="wodx-quiet">{{wodx.mien}}</div>
						</div>
						<div class="wodx-col healthBox">
							{{> "systems/worldofdarkness/templates/actor/parts/stats_health_old.html"}}
							<div class="sheet-headline headlineGroup splatFont">
								<div class="sheet-banner-small"><span class="sheet-banner-text">{{localize 'wod.experience.experience'}}</span></div>
								<div class="total experienceValue">{{getTotalExperience actor "total"}}</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			{{!-- Page two of the book's sheet: Oaths, Echoes, Features --}}
			<div class="tab dreaming sheet-inner-area" data-group="primary" data-tab="dreaming">
				<div class="clearareaBox area-box wodx-page2">
					<div class="sheet-headline sheet-banner splatFont"><span class="sheet-banner-text">Oaths, Echoes and Features</span></div>
					<div class="wodx-cols">
						<div class="wodx-col"><div class="headlineGroup splatFont">Oaths</div>
							{{#each wodx.oaths}}<div class="wodx-line {{#unless this.active}}wodx-inactive{{/unless}}"><b>{{this.kind}} {{this.rating}}</b> {{this.terms}}</div>{{else}}<div class="wodx-quiet">None.</div>{{/each}}
							<a class="wodx-roll wodx-small" data-roll="daOath">Keep an oath</a></div>
						<div class="wodx-col"><div class="headlineGroup splatFont">Echoes</div>
							{{#each wodx.echoes}}<div class="wodx-line">{{this}}</div>{{else}}<div class="wodx-quiet">None.</div>{{/each}}
							<a class="wodx-roll wodx-small" data-roll="daEcho">Face an Echo</a></div>
						<div class="wodx-col"><div class="headlineGroup splatFont">Features</div>
							{{#each wodx.greater}}<div class="wodx-line"><b>Greater:</b> {{this}}</div>{{/each}}
							{{#each wodx.lesser}}<div class="wodx-line">{{this}}</div>{{/each}}
							{{#unless wodx.anyFeature}}<div class="wodx-quiet">None.</div>{{/unless}}
							<a class="wodx-roll wodx-small" data-roll="daMien">Take or drop the mien</a></div>
					</div>
					<div class="wodx-actions-row">
						<button type="button" class="wodx-roll" data-roll="daFae"><i class="fas fa-scroll"></i> Edit Origin, Court, cantrips, Features, Echoes and Oaths</button>
						<button type="button" class="wodx-roll" data-roll="daCounter"><i class="fas fa-shield-alt"></i> Counter</button>
						<button type="button" class="wodx-roll" data-roll="daRest"><i class="fas fa-tree"></i> Rest in a faerie realm</button>
					</div>
					<div class="wodx-quiet">{{wodx.book}}; the systems in WoDX's own words are on each card.</div>
				</div>
			</div>

			<div class="tab power sheet-inner-area" data-group="primary" data-tab="power">{{> "systems/worldofdarkness/templates/actor/parts/creature/power.html"}}</div>
			<div class="tab combat sheet-inner-area" data-group="primary" data-tab="combat">{{> "systems/worldofdarkness/templates/actor/parts/combat.html"}}</div>
			<div class="tab gear sheet-inner-area" data-group="primary" data-tab="gear">{{~> "systems/worldofdarkness/templates/actor/parts/gear.html"}}</div>
			<div class="tab note sheet-inner-area" data-group="primary" data-tab="note">{{> "systems/worldofdarkness/templates/actor/parts/notes.html"}}</div>
			<div class="tab effect sheet-inner-area" data-group="primary" data-tab="effect">{{> "systems/worldofdarkness/templates/actor/parts/effect.html"}}</div>
			<div class="tab settings sheet-inner-area" data-group="primary" data-tab="settings">{{> "systems/worldofdarkness/templates/actor/parts/settings.html"}}</div>
		</section>
	</div>
</form>
